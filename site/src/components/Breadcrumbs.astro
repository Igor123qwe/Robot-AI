---
interface Props {
  items: { href: string; label: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Хлебные крошки">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i === items.length - 1 ? (
            <span aria-current="page">{item.label}</span>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
