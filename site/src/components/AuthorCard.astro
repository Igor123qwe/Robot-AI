---
import { AUTHOR } from '../../site.config.mjs';
---

<aside class="author-card">
  <img src={AUTHOR.photo} width="64" height="64" alt={`${AUTHOR.name} — ${AUTHOR.jobTitle}`} loading="lazy" />
  <div>
    <p class="author-card__name">{AUTHOR.name}</p>
    <p class="author-card__role">{AUTHOR.jobTitle}</p>
    <p>{AUTHOR.short} <a href="/o-nas/">Подробнее об экспертизе</a>.</p>
  </div>
</aside>
