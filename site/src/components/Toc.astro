---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  variant?: 'inline' | 'aside';
}
const { headings, variant = 'inline' } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 3 && (
    <nav class={`toc toc--${variant}`} aria-label="Содержание статьи">
      <p class="toc__title">Содержание</p>
      <ol>
        {items.map((h) => (
          <li data-depth={h.depth}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
