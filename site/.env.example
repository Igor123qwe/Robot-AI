# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.
# Значения из блока «Сайт» читаются при сборке, остальные — обработчиком форм.

# ---------- Сайт (используется при сборке) ----------
# Плейсхолдеры из §0 ТЗ. Можно не задавать здесь, а один раз
# отредактировать site.config.mjs — переменные окружения имеют приоритет.
PUBLIC_DOMAIN=example.ru
PUBLIC_BRAND=Название студии
PUBLIC_LEGAL_NAME=ИП Иванов Иван Иванович
PUBLIC_INN=000000000000
PUBLIC_TG_PERSONAL=https://t.me/username
PUBLIC_TG_BOT=https://t.me/username_bot
PUBLIC_EMAIL=hello@example.ru
PUBLIC_PHONE=
PUBLIC_CITY=Москва
PUBLIC_SINCE=2019
PUBLIC_SKU_PROCESSED=12 000
PUBLIC_AUTHOR_NAME=Иван Иванов

# Куда формы отправляют заявку. Оставьте /api/lead, если форму
# проксирует nginx на server/forms.mjs (см. deploy/nginx.conf).
PUBLIC_FORM_ENDPOINT=/api/lead

# Счётчики. Пустое значение — счётчик не подключается.
PUBLIC_METRIKA_ID=
PUBLIC_GA4_ID=

# ---------- IndexNow (§5.6) ----------
# Произвольная строка 8–128 символов из латиницы и цифр. При сборке
# кладётся в корень домена как <ключ>.txt, при деплое используется для пинга.
INDEXNOW_KEY=

# ---------- Обработчик форм (server/forms.mjs) ----------
PORT=8787
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALLOWED_ORIGIN=https://example.ru
RATE_LIMIT=5
RATE_WINDOW_MS=600000

# Дублирование заявок на почту — необязательно.
# Требует установленного nodemailer (входит в optionalDependencies).
SMTP_URL=
MAIL_TO=
MAIL_FROM=
