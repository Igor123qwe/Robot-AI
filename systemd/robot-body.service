[Unit]
Description=Robot-AI: детектор людей на BPU и раздача картинки (порт 8080)
After=network.target
# Раньше пульта намеренно: камерой владеет этот узел, а пульт берёт картинку
# у него. Стартуй они наоборот, пульт успел бы схватить /dev/video0 первым, и
# детектор упал бы с «terminate called after throwing an instance of char*» —
# без единого слова о том, что устройство занято.
Before=robot-web.service
# Restart=always ниже — это не «всегда», пока стоит лимит по умолчанию: пять
# запусков за десять секунд, и дальше юнит уходит в failed навсегда. Камера,
# занятая чем-то посторонним, — ровно тот случай, когда падения идут подряд;
# без этой строки детектор тел молча исчезает до перезагрузки, а робот
# перестаёт видеть людей и никому об этом не сообщает.
StartLimitIntervalSec=0

[Service]
Type=simple
User=wheeltec
WorkingDirectory=/home/wheeltec/Robot-AI
EnvironmentFile=-/home/wheeltec/.robot-ai.env
ExecStart=/bin/bash /home/wheeltec/Robot-AI/scripts/body_service.sh
Restart=always
# Пятнадцать секунд, а не пять: узел поднимает модель на BPU и открывает
# камеру, и перезапуск чаще этого превращается в бесконечную карусель, если
# камера занята чем-то посторонним.
RestartSec=15

[Install]
WantedBy=multi-user.target
