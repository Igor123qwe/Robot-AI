# Шаблон секретов. Скопировать в ~/.robot-ai.env и заполнить.
# Сам ~/.robot-ai.env в репозиторий НЕ попадает.

# --- домашний ПК: без него робот молчит --------------------------------------
# Робот работает ТОЛЬКО в паре с домашним ПК (решение хозяина, октябрь 2026).
# Одна строка на всё: распознавание речи, разговор, голос, зрение и лицо на
# экране. Своего распознавания, своего голоса, облака и своего лица у робота
# нет.
#
# ПК выключен, kuzya_pc.py не запущен или на ПК не поднята Ollama — робот
# молчит: не объявляет «нет сети», не говорит «работаю сам», на экране только
# часы и строка состояния. «Кузя, стоп», кнопка СТОП и сторож мёртвой руки от
# ПК не зависят — остановка колёс местная.
#
# На ПК нужны Ollama и pc/kuzya_pc.py из этого репозитория, а для лица —
# Playwright. Как поставить — в pc/README.md. Пусто — робот не слушает и
# лица на экране нет.
ROBOT_PC_URL=

# Раздельные адреса нужны, только если распознавание, разговор и голос
# разнесены по разным машинам. Обычно оставить пустыми — они выводятся из
# ROBOT_PC_URL.
ROBOT_LOCAL_API_BASE=
ROBOT_STT_URL=
ROBOT_TTS_URL=

# Имя модели на ПК. Что скачано, покажет `ollama list`.
ROBOT_LOCAL_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Своя машина в своей сети пароля не спрашивает, но клиент без ключа работать
# отказывается. Настоящий ключ сюда писать не нужно — любая строка.
ROBOT_LOCAL_API_KEY=local

# Общий потолок ответа модели. Домашняя модель всё равно режется своим,
# маленьким пределом (brain.py, МЕСТНЫЙ_ПРЕДЕЛ): реплика вслух — это десятки
# токенов, а не тысячи. Краткость держится системным промптом, а не этим
# числом.
ROBOT_MAX_TOKENS=8000

# Источник аудио и видео.
# phone   — старый Android с приложением IP Webcam (временное решение)
# local   — микрофон, воткнутый в RDK X5 (после приезда ReSpeaker)
# browser — микрофон компьютера через вкладку пульта. Удобно для разговора
#           за столом: наушники на голове, эха нет, телефон не нужен.
#           Требует, чтобы пульт был открыт по localhost (см. voice/README.md).
ROBOT_AUDIO_SOURCE=phone
# Тот же адрес использует прокси камеры в web/server.py.
ROBOT_PHONE_URL=http://192.168.3.9:8080

# Камера. Пусто — сама разберётся: есть камера в роботе, значит она; нет —
# телефон с IP Webcam. usb или phone — заставить выбрать.
# Камерой владеет ОДИН процесс, веб-сервер: устройство захватывается
# монопольно, и если бы за него боролись пульт и голос, то открытая вкладка
# оставляла бы робота слепым.
ROBOT_CAMERA=
# Пусто — ищем сами в /dev/v4l/by-id (имя постоянное, номер /dev/videoN — нет).
ROBOT_CAMERA_DEVICE=
# Разрешение, частота и качество JPEG (1 — лучшее, 31 — худшее). Девяносто
# кадров роботу незачем: он смотрит, а не снимает кино, — а вот полосу на USB
# и процессор они съедят.
ROBOT_CAMERA_SIZE=1280x1024
ROBOT_CAMERA_FPS=10
ROBOT_CAMERA_QUALITY=6

# Кем робот смотрит. Смотрит за робота ПК: кадр уходит туда же, куда речь, и
# только туда — ПК не разглядел, робот молчит. Разговорная модель на ПК
# зрения не имеет, поэтому для «что ты видишь» нужна отдельная — поставить её
# на ПК так:
#     ollama pull qwen2.5vl:7b
# Держать зрячую модель ещё и в разговоре незачем: смотрит робот изредка, а
# разговаривает постоянно, и платил бы памятью и скоростью за каждую фразу.
# Читает эту настройку ПК (pc/kuzya_pc.py), а не робот: другую модель задают
# в окружении ПК (на Windows — setx ROBOT_PC_VISION_MODEL …).
ROBOT_PC_VISION_MODEL=qwen2.5vl:7b

# Имя робота. Робот слушает всегда, но откликается только на него.
# Несколько вариантов через запятую — Whisper пишет имя по-разному.
ROBOT_WAKE_WORDS=кузя,кузь,куся,кузи,кузьма
# Сколько секунд после ответа он продолжает слушать без имени.
# Больше — удобнее разговаривать, но выше риск поймать разговор в комнате.
ROBOT_SESSION_SECONDS=20
# Порог похожести имени, 0..1. Ниже 0.75 начнёт ловить лишнее.
ROBOT_WAKE_RATIO=0.8

# Голос — синтез на ПК, и выбирается он там же (kuzya_pc.py --voice). Здесь
# можно попросить другой из тех, что у ПК есть. Пусто — тот, что выбран на ПК.
ROBOT_PC_VOICE=

# Куда говорить.
# browser — играет браузер с открытым пультом (пока своего динамика нет)
# local   — сразу в aplay (когда приедет SOTAMIA)
ROBOT_AUDIO_OUT=browser
ROBOT_WEB_URL=http://127.0.0.1:8000
# Порт веб-пульта. Меняется вместе с ROBOT_WEB_URL — иначе робот продолжит
# стучаться в 8000, и реплики просто перестанут доезжать до пульта.
ROBOT_WEB_PORT=8000

# rosbridge — через него голосовой пайплайн шлёт /cmd_vel
ROBOT_ROSBRIDGE_URL=ws://127.0.0.1:9090

# Громкость голоса, 0.1–1.0. Меняется на ходу командой «говори тише» и
# сохраняется в ~/.robot-ai/settings.json — эта настройка её перебивает только
# при первом запуске.
ROBOT_VOLUME=1.0
# Тихие часы «начало-конец» в 24-часовом формате. В это время робот говорит
# вполголоса и не здоровается при перезапуске. Будильники и таймеры звучат в
# полную громкость — их для того и ставили. Пусто — выключить режим.
ROBOT_QUIET_HOURS=23-8
ROBOT_QUIET_VOLUME=0.45

# Ехать только по имени. В разговоре без имени командой выглядит любая фраза
# из комнаты — телевизор, разговор с другим человеком, — а поехать по ошибке
# уже не отменить. Остановка, таймеры и вопросы имя не требуют. 0 — разрешить
# езду и в разговоре.
ROBOT_MOTION_NEEDS_NAME=1

# Где робот хранит то, что должно пережить перезапуск: таймеры, список
# покупок, громкость.
ROBOT_DATA_DIR=

# Координаты дома для погоды (open-meteo, без ключа и без регистрации).
# Взять можно в любой карте: правый клик по своему дому. Пусто — робот честно
# скажет, что не знает, где находится, и погоду выдумывать не станет.
ROBOT_LAT=
ROBOT_LON=

# Сохранять услышанное в /tmp/robot-audio, чтобы послушать ушами.
# Нужно только для отладки распознавания.
ROBOT_DEBUG_AUDIO=0

# Яндекс.Музыка. Пусто — играет интернет-радио, и это рабочий режим, а не
# поломка: радио бесплатно, бессрочно и не зависит от чужой подписки. С
# токеном добавляется то, чего радио не умеет: конкретный исполнитель,
# конкретная песня и «Моя волна».
#
# Нужна активная подписка Плюс: без неё Яндекс отдаёт тридцать секунд от
# каждого трека. Получить токен — python3 voice/yandex_auth.py, он запишет
# его сюда сам. Руками вписывать не надо.
YANDEX_MUSIC_TOKEN=

# Определитель конца реплики по звуку. Пусто — робот режет запись по тишине.
#
# Тишина — плохой признак: в квартире с ребёнком или телевизором её не бывает
# вовсе, и запись каждый раз доезжает до потолка окна команды. Человек сказал
# «Кузя, сколько времени» за две секунды и ждёт ещё три, пока робот пишет
# комнату, уже всё расслышав. В журнале ПК это «на 5.0 с звука» подряд.
#
# Ставится одной командой:  bash scripts/setup_turn_end.sh
# ROBOT_TURN_MODEL=/home/wheeltec/smart-turn/smart-turn-v3.1-cpu.onnx
#
# Насколько уверенной должна быть сеть, чтобы оборвать запись. Планка высокая
# намеренно: обрезать человека на полуслове хуже, чем подождать лишнее.
# ROBOT_TURN_THRESHOLD=0.85
#
# Чем отвечает модель, если робот не разобрал сам («отвечает непонятно чем» в
# журнале, а дальше «спросили много, оборвали 0»): вероятность | логит
# ROBOT_TURN_OUTPUT=вероятность
